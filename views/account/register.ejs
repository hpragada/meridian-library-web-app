<p class="lede">Fill in the form and collect your card from any branch with proof of address.</p>

<form action="/account/register" method="post">
  <div class="field">
    <label for="apply-name">Full name</label>
    <input id="apply-name" type="text" name="name">
  </div>
  <div class="field">
    <label for="apply-email">Email address</label>
    <input id="apply-email" type="email" name="email">
  </div>
  <div class="field">
    <label for="apply-postcode">Postcode</label>
    <input id="apply-postcode" type="text" name="postcode">
  </div>
  <button id="apply-submit" type="submit" aria-label="Join the library">Join</button>
</form>
