<p class="lede">Keep your membership record up to date so we can reach you about reservations.</p>

<form action="/account/update-details" method="post">
  <div class="field">
    <label class="label-required" for="join-name">Full name (required)</label>
    <input id="join-name" type="text" name="name" aria-required="true">
  </div>
  <div class="field">
    <label class="label-required" for="join-dob">Date of birth (required)</label>
    <input id="join-dob" type="date" name="dob" aria-required="true">
  </div>
  <div class="field">
    <label for="join-email">Email address</label>
    <input id="join-email" type="email" name="email">
  </div>
  <div class="field">
    <label for="join-address">Address</label>
    <input id="join-address" type="text" name="address">
  </div>
  <div class="field">
    <label class="label-required" for="join-postcode">Postcode (required)</label>
    <input id="join-postcode" type="text" name="postcode" aria-required="true">
  </div>
  <button type="submit">Save changes</button>
</form>
