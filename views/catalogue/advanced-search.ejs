<p class="lede">Look for a title, an author, or a subject.</p>

<form action="/catalogue/advanced-search" method="get">
  <div class="field">
    <label for="search-term">Title, author or subject</label>
    <input id="search-term" type="text" name="q">
  </div>
  <div class="field">
    <label for="search-shelf">Shelfmark begins with</label>
    <input id="search-shelf" type="text" name="shelf">
  </div>
  <button id="search-submit" type="submit" aria-label="Search books">Search</button>
</form>

<p class="muted">Searching covers every branch. Items held elsewhere can be sent to your home
  branch, usually within three working days.</p>
