<p class="lede">Every title currently on the open shelves at Fenner Road.</p>
<ul class="covers">
<% books.forEach(function (b) { %>
  <li>
    <img id="shelf-<%= b.id %>" src="/assets/covers/<%= b.id %>.svg" width="200" height="300"
         alt="<%= b.title %> by <%= b.author %> — cover showing <%= b.depicts %>">
    <p class="title"><%= b.title %></p>
    <p class="author"><%= b.author %></p>
  </li>
<% }); %>
<% moreBooks.forEach(function (b) { %>
  <li>
    <img id="shelf-<%= b.id %>" src="/assets/covers/<%= b.id %>.svg" width="200" height="300"
         alt="<%= b.altStyle %>">
    <p class="title"><%= b.title %></p>
    <p class="author"><%= b.author %></p>
  </li>
<% }); %>
</ul>
<p class="muted">Titles held at other branches can be requested at the front desk.</p>
