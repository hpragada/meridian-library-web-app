<p class="lede">Narrow the catalogue down to one subject.</p>

<form id="filter-form" action="/catalogue/filter" method="get">
  <div class="field">
    <label for="filter-genre">Subject</label>
    <select id="filter-genre" name="genre" onchange="this.form.submit()">
      <option value="">All subjects</option>
<% genreCounts.forEach(function (g) { %>
      <option value="<%= g.name %>"><%= g.name %></option>
<% }); %>
    </select>
  </div>
</form>

<h2>Results</h2>
<ul class="stack">
<% books.forEach(function (b) { %>
  <li><%= b.title %> — <%= b.author %> — <%= b.genre %></li>
<% }); %>
</ul>
