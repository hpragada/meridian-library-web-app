<p class="lede">Everything on our shelves, across all eight branches.</p>
<ul class="covers">
<% books.forEach(function (b) { %>
  <li>
    <img id="cat-<%= b.id %>" src="/assets/covers/<%= b.id %>.svg" width="200" height="300"
         alt="<%= b.title %> by <%= b.author %> — cover showing <%= b.depicts %>">
    <p class="title"><%= b.title %></p>
    <p class="author"><%= b.author %></p>
  </li>
<% }); %>
</ul>
