<p class="lede">How many titles we hold in each subject, and how many are out on loan today.</p>

<h2>Holdings by subject</h2>

<table id="subject-table">
  <thead>
    <tr>
      <th scope="col" id="sub-h1">Subject</th>
      <th scope="col" id="sub-h2">Titles</th>
      <th scope="col" id="sub-h3">On loan</th>
      <th scope="col" id="sub-h4">Available</th>
      <th scope="col" id="sub-h5">Shelfmark</th>
    </tr>
  </thead>
  <tbody>
<% genreCounts.forEach(function (g) { var onLoan = Math.round(g.count * 0.18); %>
    <tr>
      <td><%= g.name %></td>
      <td><%= g.count %></td>
      <td><%= onLoan %></td>
      <td><%= g.count - onLoan %></td>
      <td><%= g.name.slice(0, 3).toUpperCase() %></td>
    </tr>
<% }); %>
  </tbody>
</table>

<p class="muted">Counts cover every branch and are refreshed overnight.</p>
