<%
  // Fixed geometry so the two branch charts on this site are pixel-for-pixel comparable.
  var X0 = 70, X1 = 520, YTOP = 40, YBASE = 290, SCALE = 900;
  var x = function (i) { return Math.round(X0 + i * ((X1 - X0) / (monthlyLoans.length - 1))); };
  var y = function (v) { return Math.round(YBASE - (v / SCALE) * (YBASE - YTOP)); };
%>
<p class="lede">Loans issued at our three largest branches, January to August.</p>

<svg class="chart" width="640" height="340" viewBox="0 0 640 340" role="img"
     aria-label="Loans by branch, January to August. Fenner Road rises from 610 in January to 810 in May and falls to 520 in August. Ashcombe rises from 140 to 280 in May and falls to 160. North Quay rises from 70 to 150 in May and falls to 100.">
  <rect x="0" y="0" width="640" height="340" fill="#ffffff"/>
  <g stroke="#d9d9d9" stroke-width="1">
<% [0, 300, 600, 900].forEach(function (v) { %>
    <line x1="<%= X0 %>" y1="<%= y(v) %>" x2="<%= X1 %>" y2="<%= y(v) %>"/>
<% }); %>
  </g>
  <g fill="#1a1a1a" font-family="system-ui, sans-serif" font-size="12">
<% [0, 300, 600, 900].forEach(function (v) { %>
    <text x="<%= X0 - 10 %>" y="<%= y(v) + 4 %>" text-anchor="end"><%= v %></text>
<% }); %>
<% monthlyLoans.forEach(function (m, i) { %>
    <text x="<%= x(i) %>" y="<%= YBASE + 20 %>" text-anchor="middle"><%= m.month %></text>
<% }); %>
  </g>
<% branchComparison.forEach(function (b) { %>
  <polyline fill="none" stroke="<%= b.colour %>" stroke-width="3"
            points="<%= b.counts.map(function (c, i) { return x(i) + "," + y(c); }).join(" ") %>"/>
<% }); %>
</svg>

<ul class="legend" id="branch-legend">
<% branchComparison.forEach(function (b) { %>
  <li><span class="swatch" style="background: <%= b.colour %>"></span> <%= b.name %></li>
<% }); %>
</ul>

<p class="muted">Figures exclude renewals and items issued through the self-service machines.</p>
