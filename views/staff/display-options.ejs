<p class="lede">Settings here apply to the catalogue as every member sees it.</p>

<h2>Catalogue display</h2>
<div class="switch-row">
  <span id="label-closed-branches">Show closed branches</span>
  <button type="button" id="toggle-closed-branches" class="switch" role="switch"
          aria-checked="true" aria-labelledby="label-closed-branches"
          onclick="toggleSwitch(this)"></button>
</div>
<div class="switch-row">
  <span id="label-reference-only">Show reference-only items</span>
  <button type="button" id="toggle-reference-only" class="switch" role="switch"
          aria-checked="false" aria-labelledby="label-reference-only"
          onclick="toggleSwitch(this)"></button>
</div>

<p class="muted">Changes are picked up by the public catalogue within a few minutes.</p>

<script src="/js/staff-controls.js"></script>
