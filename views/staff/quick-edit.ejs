<p class="lede">Correct a catalogue record without opening the full entry form.</p>

<form action="/staff/quick-edit" method="post">
  <div class="field">
    <label for="entry-title">Title</label>
    <input id="entry-title" type="text" name="title">
  </div>
  <div class="field">
    <label for="entry-author">Author</label>
    <input id="entry-author" type="text" name="author">
  </div>
  <div class="field">
    <label for="entry-shelf">Shelfmark</label>
    <input id="entry-shelf" type="text" name="shelf">
  </div>
  <button type="button" id="save-entry" class="btn" onclick="saveEntry()">Save</button>
</form>

<script src="/js/staff-controls.js"></script>
