<p class="lede">Sections checked during this month's shelf audit.</p>

<h2>Shelf sections</h2>
<div class="switch-row">
  <span id="label-shelf-fiction">Fiction</span>
  <div id="shelf-fiction" class="switch is-on" onclick="toggleSwitch(this)"></div>
</div>
<div class="switch-row">
  <span id="label-shelf-reference">Reference</span>
  <div id="shelf-reference" class="switch is-on" onclick="toggleSwitch(this)"></div>
</div>
<div class="switch-row">
  <span id="label-shelf-childrens">Children's</span>
  <div id="shelf-childrens" class="switch" onclick="toggleSwitch(this)"></div>
</div>
<div class="switch-row">
  <span id="label-shelf-local">Local history</span>
  <div id="shelf-local" class="switch is-on" onclick="toggleSwitch(this)"></div>
</div>

<p class="muted">Sections left unchecked roll over to next month's audit list.</p>

<script src="/js/staff-controls.js"></script>
